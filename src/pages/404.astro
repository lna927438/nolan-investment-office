---
import "../styles/global.css";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#f1eee7" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Page Not Found | Nolan Investment Office</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap nav">
        <a class="brand" href="/" aria-label="Nolan Investment Office home">
          <strong>NOLAN</strong>
          <span>Investment Office</span>
        </a>
      </div>
    </header>
    <main class="wrap error-page">
      <div>
        <div class="section-number">404 / Page not found</div>
        <h1>This page is not here.</h1>
        <p>The address may have changed, or the page may no longer be available.</p>
        <a class="text-link" href="/">Return home</a>
      </div>
    </main>
  </body>
</html>
