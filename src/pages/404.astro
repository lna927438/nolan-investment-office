---
import SiteLayout from "../components/SiteLayout.astro";
const base = import.meta.env.BASE_URL;
---
<SiteLayout
  title="Page Not Found | Nolan Investment Office"
  description="The requested page could not be found."
  showFooter={false}
>
  <div class="wrap error-page">
    <div>
      <div class="section-number">404 / Page not found</div>
      <h1>This page is not here.</h1>
      <p>The address may have changed, or the page may no longer be available.</p>
      <a class="text-link" href={base}>Return home</a>
    </div>
  </div>
</SiteLayout>
