---
import "../styles/global.css";
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,follow" />
    <meta name="theme-color" content="#f1eee7" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>Legal | Nolan Investment Office</title>
    <meta name="description" content="Legal information and website disclosures for Nolan Investment Office." />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap nav">
        <a class="brand" href={base} aria-label="Nolan Investment Office home">
          <strong>NOLAN</strong>
          <span>Investment Office</span>
        </a>
        <nav aria-label="Secondary navigation">
          <a href={base}>Home</a>
        </nav>
      </div>
    </header>

    <main class="legal-page">
      <div class="wrap legal-wrap">
        <div class="section-number">Legal / Website Information</div>
        <h1>Website disclosures.</h1>

        <div class="legal-copy">
          <section>
            <h2>General information</h2>
            <p>
              This website is provided for general informational purposes only.
              Nothing on this website is intended to constitute, and should not
              be construed as, investment, legal, tax, accounting or other
              professional advice.
            </p>
          </section>

          <section>
            <h2>No offer or solicitation</h2>
            <p>
              Nothing on this website constitutes an offer to sell, a
              solicitation of an offer to buy, or a recommendation regarding
              any security, investment product, investment strategy or advisory
              service.
            </p>
          </section>

          <section>
            <h2>No advisory relationship</h2>
            <p>
              Use of this website, including contacting Nolan Investment Office
              through information published here, does not create an investment
              advisory, fiduciary, client or other professional relationship.
            </p>
          </section>

          <section>
            <h2>Forward-looking information</h2>
            <p>
              Statements regarding markets, industries, companies or future
              opportunities may reflect opinions or expectations and are
              subject to change without notice. Actual outcomes may differ
              materially.
            </p>
          </section>

          <section>
            <h2>Third-party information</h2>
            <p>
              References to third-party companies, products, services or
              websites, if any, are provided for context and do not imply an
              endorsement or guarantee of accuracy.
            </p>
          </section>

          <section>
            <h2>Website status</h2>
            <p>
              This page is a working website disclosure and should be reviewed
              against the final legal entity name, business activities and
              jurisdictional requirements before public launch.
            </p>
          </section>
        </div>

        <a class="text-link" href={base}>Return to Nolan Investment Office</a>
      </div>
    </main>
  </body>
</html>
