---
import SiteLayout from "../components/SiteLayout.astro";
---
<SiteLayout
  active="home"
  showFooter={false}
  description="Nolan Investment Office is an independent investment office focused on technology, healthcare, energy, infrastructure and selected enduring businesses."
>
  <div id="top" class="wrap hero home-hero">
    <div class="hero-inner" data-reveal>
      <div class="eyebrow">Independent Investment Office</div>
      <h1>Selective capital.<br />Long-term perspective.</h1>
      <div class="hero-bottom">
        <div class="hero-copy">
          Nolan Investment Office invests selectively across technology,
          healthcare, energy, infrastructure and enduring businesses.
        </div>
        <div class="hero-note">
          California based. Privately managed. Built around direct
          relationships and a research-led investment process.
        </div>
      </div>
    </div>
  </div>
</SiteLayout>
