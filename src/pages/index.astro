---
import "../styles/global.css";

const focus = [
  ["01", "Technology", "AI, automation and software-led business models with practical, durable applications."],
  ["02", "Healthcare", "Digital health, life sciences and medical technology that improve care, access or outcomes."],
  ["03", "Energy & Infrastructure", "Essential systems, energy and enabling infrastructure supporting long-term demand."],
  ["04", "Selective Consumer", "Distinctive businesses where product, brand, technology and customer loyalty intersect."]
];

const approach = [
  ["01", "Long-term perspective", "We favor durable businesses and patient decision-making over short-term activity."],
  ["02", "Selective capital", "We invest deliberately, with a focused review process and a high bar for conviction."],
  ["03", "Direct relationships", "We value thoughtful, straightforward relationships with founders, operators and professional partners."]
];

const contactTypes = [
  ["Founders & operators", "Company introductions and relevant business opportunities."],
  ["Professional correspondence", "Legal, finance, advisory and operating matters."],
  ["General office", "All other business correspondence for the office."]
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Nolan Investment Office is an independent California-based investment office focused on technology, healthcare, energy, infrastructure and selected enduring businesses." />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#f1eee7" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Nolan Investment Office" />
    <meta property="og:description" content="Selective capital. Long-term perspective." />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Nolan Investment Office" />
    <meta name="twitter:description" content="Selective capital. Long-term perspective." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Nolan Investment Office | Independent Investment Office</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap nav">
        <a class="brand" href="#top" aria-label="Nolan Investment Office home">
          <strong>NOLAN</strong>
          <span>Investment Office</span>
        </a>
        <nav aria-label="Primary navigation">
          <a href="#focus">Focus</a>
          <a href="#approach">Approach</a>
          <a href="#office">Office</a>
          <a href="#contact">Contact</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <div id="top" class="wrap hero">
        <div class="hero-inner" data-reveal>
          <div class="eyebrow">Independent Investment Office · California</div>
          <h1>Selective capital.<br />Long-term perspective.</h1>
          <div class="hero-bottom">
            <div class="hero-copy">
              An independent investment office focused on a small number of
              opportunities across technology, healthcare, energy,
              infrastructure and selected enduring businesses.
            </div>
            <div class="hero-note">
              Privately managed. Direct relationships. Research-led decision
              making.
            </div>
          </div>
        </div>
      </div>

      <section id="focus">
        <div class="wrap" data-reveal>
          <div class="section-head">
            <div class="section-number">01 / Focus</div>
            <h2>A focused set of sectors.</h2>
          </div>
          <div class="grid">
            {focus.map(([n, title, text]) => (
              <article class="item">
                <span>{n}</span>
                <h3>{title}</h3>
                <p>{text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="approach">
        <div class="wrap" data-reveal>
          <div class="section-head">
            <div class="section-number">02 / Approach</div>
            <h2>Deliberate by design.</h2>
          </div>
          <div class="approach-list">
            {approach.map(([n, title, text]) => (
              <div class="approach-row">
                <small>{n}</small>
                <strong>{title}</strong>
                <p>{text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="office">
        <div class="wrap" data-reveal>
          <div class="section-head">
            <div class="section-number">03 / Office</div>
            <h2>Independent by structure.</h2>
          </div>
          <div class="office-copy">
            Nolan Investment Office is an independent, California-based
            investment office led by Renee Nolan. The office operates with a
            small dedicated team and professional partners, keeping research,
            diligence and day-to-day coordination close to the decision-making
            process.
          </div>
          <div class="office-meta">
            <p>
              Opportunities are reviewed selectively, with emphasis on business
              quality, practical diligence and long-term alignment.
            </p>
            <p>
              Relationships are handled directly. The office is not structured
              around a high-volume sourcing model.
            </p>
          </div>
        </div>
      </section>

      <section id="contact" class="contact">
        <div class="wrap" data-reveal>
          <div class="section-number">04 / Contact</div>
          <h2>Office correspondence.</h2>
          <div class="contact-grid">
            {contactTypes.map(([title, text]) => (
              <div class="contact-item">
                <h3>{title}</h3>
                <p>{text}</p>
              </div>
            ))}
          </div>
          <div class="contact-line">
            <span class="dot" aria-hidden="true"></span>
            <span>Direct office contact details will be published with the formal launch.</span>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap footer-grid">
        <p class="disclaimer">
          For general informational purposes only. Nothing on this website
          constitutes an offer, solicitation, investment recommendation or
          advisory relationship.
        </p>
        <div class="footer-side">
          <a href="/legal">Legal</a>
          <span>California, United States</span>
          <span>© 2026 Nolan Investment Office</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const items = document.querySelectorAll('[data-reveal]');
      if (reduceMotion || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12 });
        items.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
