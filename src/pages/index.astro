---
import "../styles/global.css";

const base = import.meta.env.BASE_URL;

const focus = [
  ["01", "Technology", "AI, automation and software-led business models with practical, durable applications."],
  ["02", "Healthcare", "Digital health, life sciences and medical technology that improve care, access or outcomes."],
  ["03", "Energy & Infrastructure", "Essential systems, energy and enabling infrastructure supporting long-term demand."],
  ["04", "Selective Consumer", "Distinctive businesses where product, brand, technology and customer loyalty intersect."]
];

const approach = [
  ["01", "Long-term perspective", "We favor durable businesses and patient decision-making over short-term activity."],
  ["02", "Selective capital", "We invest deliberately, with a focused review process and a high bar for conviction."],
  ["03", "Direct relationships", "We value thoughtful, straightforward relationships with founders, operators and partners."]
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Nolan Investment Office is an independent investment office focused on technology, healthcare, energy, infrastructure and selected enduring businesses." />
    <meta name="robots" content="noindex,follow" />
    <meta name="theme-color" content="#f1eee7" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Nolan Investment Office" />
    <meta property="og:description" content="Independent investing with a selective, long-term perspective." />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Nolan Investment Office" />
    <meta name="twitter:description" content="Independent investing with a selective, long-term perspective." />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>Nolan Investment Office</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap nav">
        <a class="brand" href="#top" aria-label="Nolan Investment Office home">
          <strong>NOLAN</strong>
          <span>Investment Office</span>
        </a>
        <nav aria-label="Primary navigation">
          <a href="#focus">Focus</a>
          <a href="#approach">Approach</a>
          <a href="#office">Office</a>
          <a href="#contact">Contact</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <div id="top" class="wrap hero">
        <div class="hero-inner" data-reveal>
          <div class="eyebrow">Independent Investment Office</div>
          <h1>Selective capital.<br />Long-term perspective.</h1>
          <div class="hero-bottom">
            <div class="hero-copy">
              Nolan Investment Office invests selectively across technology,
              healthcare, energy, infrastructure and enduring businesses.
            </div>
            <div class="hero-note">
              California based. Privately managed. Built around direct
              relationships and a research-led investment process.
            </div>
          </div>
        </div>
      </div>

      <section id="focus">
        <div class="wrap" data-reveal>
          <div class="section-head">
            <div class="section-number">01 / Focus</div>
            <h2>A focused set of sectors.</h2>
          </div>
          <div class="grid">
            {focus.map(([n, title, text]) => (
              <article class="item">
                <span>{n}</span>
                <h3>{title}</h3>
                <p>{text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="approach">
        <div class="wrap" data-reveal>
          <div class="section-head">
            <div class="section-number">02 / Approach</div>
            <h2>Deliberate by design.</h2>
          </div>
          <div class="approach-list">
            {approach.map(([n, title, text]) => (
              <div class="approach-row">
                <small>{n}</small>
                <strong>{title}</strong>
                <p>{text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="office">
        <div class="wrap" data-reveal>
          <div class="section-head">
            <div class="section-number">03 / Office</div>
            <h2>Independent by structure.</h2>
          </div>
          <div class="office-copy">
            Nolan Investment Office is an independent investment office led by
            Renee Nolan, supported by a small dedicated team across research,
            operations and professional coordination.
          </div>
          <div class="office-meta">
            <p>
              The office is structured to keep decisions direct, diligence
              practical and relationships personal.
            </p>
            <p>
              Specialist legal, accounting and other professional partners are
              engaged as appropriate. The office favors a selective pipeline,
              thoughtful review and long-term alignment over volume.
            </p>
          </div>
        </div>
      </section>

      <section id="contact" class="contact">
        <div class="wrap" data-reveal>
          <div class="section-number">04 / Contact</div>
          <h2>Office correspondence.</h2>
          <div class="contact-grid">
            <div class="contact-item">
              <h3>Founders & operators</h3>
              <p>Company introductions and operating conversations.</p>
            </div>
            <div class="contact-item">
              <h3>Professional correspondence</h3>
              <p>Advisers, service providers and institutional relationships.</p>
            </div>
            <div class="contact-item">
              <h3>General office</h3>
              <p>Direct contact details will be added before formal launch.</p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap footer-grid">
        <p class="disclaimer">
          For general informational purposes only. Nothing on this website
          constitutes an offer, solicitation, investment recommendation or
          advisory relationship.
        </p>
        <div class="footer-side">
          <span>California, United States</span>
          <a href={`${base}legal`}>Legal</a>
          <span>© 2026 Nolan Investment Office</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const items = document.querySelectorAll('[data-reveal]');
      if (reduceMotion || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12 });
        items.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
