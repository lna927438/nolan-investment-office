---
import SiteLayout from "../components/SiteLayout.astro";
import NioModelLayer from "../components/NioModelLayer.astro";
import NioIcon from "../components/NioIcon.astro";
import "../styles/home.css";

const base = import.meta.env.BASE_URL;
---
<SiteLayout
  active="home"
  showFooter={false}
  description="Nolan Investment Office is an independent investment office focused on technology, healthcare, energy, infrastructure and selected enduring businesses."
>
  <NioModelLayer />

  <section class="v3-home" aria-labelledby="home-title">
    <div class="v3-home-copy">
      <div class="v3-home-kicker">Independent Investment Office · California</div>
      <h1 id="home-title">Selective capital.<br />Enduring perspective.</h1>
      <p>
        Nolan Investment Office invests selectively across technology,
        healthcare, energy, infrastructure and enduring businesses through
        direct relationships and a research-led process.
      </p>

      <nav class="v3-home-routes" aria-label="Explore Nolan Investment Office">
        <a href={`${base}focus/`}>
          <span>01</span>
          <strong>Focus <NioIcon name="arrow-up-right" className="nio-route-icon" /></strong>
        </a>
        <a href={`${base}office/`}>
          <span>02</span>
          <strong>Office <NioIcon name="arrow-up-right" className="nio-route-icon" /></strong>
        </a>
        <a href={`${base}contact/`}>
          <span>03</span>
          <strong>Contact <NioIcon name="arrow-up-right" className="nio-route-icon" /></strong>
        </a>
      </nav>
    </div>

    <figure class="v3-home-media">
      <img
        src={`${base}media/office-architecture.webp`}
        alt="Abstract concrete architecture used as an editorial study of structure, material and light."
        width="1200"
        height="900"
        loading="eager"
        fetchpriority="high"
      />
      <span class="v3-home-code">NIO / 00</span>
      <figcaption>Interactive 3D sculpture · drag · explode</figcaption>
    </figure>
  </section>
</SiteLayout>
