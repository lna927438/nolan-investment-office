---
import SiteLayout from "../components/SiteLayout.astro";
import HomeVisualBoard from "../components/HomeVisualBoard.astro";
import "../styles/home.css";
import "../styles/home-modules.css";
import "../styles/home-visual.css";
import "../styles/home-network.css";
import "../styles/home-mobile-visual.css";
import "../styles/home-production.css";

const base = import.meta.env.BASE_URL;
---
<SiteLayout
  active="home"
  showFooter={false}
  description="Nolan Investment Office is an independent investment office focused on technology, healthcare, energy, infrastructure and selected enduring businesses."
>
  <div id="top" class="wrap hero home-hero">
    <div class="hero-inner">
      <div class="home-copy">
        <div class="eyebrow">Independent Investment Office</div>
        <h1>Selective capital.<br />Long-term perspective.</h1>
        <div class="hero-bottom">
          <div class="hero-copy">
            Nolan Investment Office invests selectively across technology,
            healthcare, energy, infrastructure and enduring businesses.
          </div>
          <div class="hero-note">
            California based. Privately managed. Built around direct
            relationships and a research-led investment process.
          </div>
        </div>
      </div>

      <HomeVisualBoard />

      <div class="home-route-rail" aria-label="Explore Nolan Investment Office">
        <a href={`${base}focus/`} class="home-route" data-module>
          <span class="home-route-index">01</span>
          <span class="home-route-label">Focus</span>
          <span class="home-route-arrow" aria-hidden="true">↗</span>
        </a>
        <a href={`${base}office/`} class="home-route" data-module>
          <span class="home-route-index">02</span>
          <span class="home-route-label">Office</span>
          <span class="home-route-arrow" aria-hidden="true">↗</span>
        </a>
        <a href={`${base}contact/`} class="home-route" data-module>
          <span class="home-route-index">03</span>
          <span class="home-route-label">Contact</span>
          <span class="home-route-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</SiteLayout>
