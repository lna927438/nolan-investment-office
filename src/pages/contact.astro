---
import SiteLayout from "../components/SiteLayout.astro";
import RouteModule from "../components/RouteModule.astro";

const base = import.meta.env.BASE_URL;

const channels = [
  {
    number: "01",
    title: "Founders & operators",
    text: "Company introductions and operating conversations. A concise overview of the business, sector, stage and relevant contact information is sufficient for an initial introduction.",
    guide: "Company · sector · stage · relevant point of contact"
  },
  {
    number: "02",
    title: "Professional correspondence",
    text: "Advisers, service providers, professional partners and institutional relationships.",
    guide: "Organization · professional role · reason for the correspondence"
  },
  {
    number: "03",
    title: "General office",
    text: "Administrative and other general office correspondence.",
    guide: "Purpose · context · preferred return contact information"
  },
];
---
<SiteLayout
  active="contact"
  title="Contact | Nolan Investment Office"
  description="Correspondence information and inquiry categories for Nolan Investment Office."
>
  <div class="wrap page-hero contact-page-hero">
    <div class="page-hero-inner">
      <div class="eyebrow">Contact · NIO / 03</div>
      <h1>Office<br />correspondence.</h1>
      <div class="page-intro">
        <p>
          The office keeps initial communication straightforward. A concise,
          relevant introduction is preferred to a long presentation at first contact.
        </p>
        <p>
          Nolan Investment Office is based in California, United States.
          Correspondence is reviewed in the context of current focus areas and ongoing work.
        </p>
      </div>
    </div>
  </div>

  <section class="page-section contact-page-section">
    <div class="wrap">
      <div class="section-head">
        <div class="section-number">01 / Routing</div>
        <h2>Start with the<br />right context.</h2>
      </div>

      <div class="v3-contact-grid">
        {channels.map((item) => (
          <article class="v3-contact-card">
            <small>{item.number}</small>
            <h2>{item.title}</h2>
            <p>{item.text}</p>
            <div class="v3-contact-guide">{item.guide}</div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <RouteModule
    eyebrow="Focus"
    title="Review the office's current areas of attention."
    label="Investment focus"
    href={`${base}focus/`}
  />
</SiteLayout>
