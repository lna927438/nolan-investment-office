---
import SiteLayout from "../components/SiteLayout.astro";
import RouteModule from "../components/RouteModule.astro";
import PageSignalDeck from "../components/PageSignalDeck.astro";
import ContactRoutingSystem from "../components/ContactRoutingSystem.astro";
import "../styles/contact-routing.css";

const channels = [
  {
    number: "01",
    code: "FOUNDER",
    title: "Founders & operators",
    text: "Company introductions and operating conversations. A concise overview of the business, sector, stage and relevant contact information is sufficient for an initial introduction.",
    guide: "Company, sector, stage and the most relevant point of contact."
  },
  {
    number: "02",
    code: "PROFESSIONAL",
    title: "Professional correspondence",
    text: "Advisers, service providers, professional partners and institutional relationships.",
    guide: "Organization, professional role and the reason the correspondence is relevant to the office."
  },
  {
    number: "03",
    code: "GENERAL",
    title: "General office",
    text: "Administrative and other general office correspondence.",
    guide: "Purpose, relevant context and the preferred return contact information."
  },
];

const contactSignals = [
  { label: "Introduction", value: "Concise", note: "Relevant context first" },
  { label: "Base", value: "California", note: "United States" },
  { label: "Routing", value: "Three channels", note: "Clear correspondence categories" },
];
---
<SiteLayout
  active="contact"
  title="Contact | Nolan Investment Office"
  description="Correspondence information and inquiry categories for Nolan Investment Office."
>
  <div class="wrap page-hero contact-page-hero">
    <div class="page-hero-inner" data-reveal>
      <div class="eyebrow">Contact</div>
      <h1>Office correspondence.</h1>
      <div class="page-intro">
        <p>
          The office keeps initial communication straightforward. A concise,
          relevant introduction is preferred to a long presentation at first contact.
        </p>
        <p>
          Nolan Investment Office is based in California, United States.
          Correspondence is reviewed in the context of the office's current
          areas of focus and ongoing work.
        </p>
      </div>
    </div>
  </div>

  <PageSignalDeck items={contactSignals} />

  <section class="page-section contact-page-section">
    <div class="wrap" data-reveal>
      <div class="section-head">
        <div class="section-number">01 / Routing</div>
        <h2>Start with the right context.</h2>
      </div>
      <ContactRoutingSystem items={channels} />
    </div>
  </section>

  <RouteModule
    eyebrow="Focus"
    title="Review the office's current areas of attention."
    label="Investment focus"
    href={`${import.meta.env.BASE_URL}focus/`}
  />
</SiteLayout>
