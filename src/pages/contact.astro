---
import SiteLayout from "../components/SiteLayout.astro";
import RouteModule from "../components/RouteModule.astro";
import PageSignalDeck from "../components/PageSignalDeck.astro";

const channels = [
  ["01", "Founders & operators", "Company introductions and operating conversations. A concise overview of the business, sector, stage and relevant contact information is sufficient for an initial introduction."],
  ["02", "Professional correspondence", "Advisers, service providers, professional partners and institutional relationships."],
  ["03", "General office", "Administrative and other general office correspondence."],
];

const contactSignals = [
  { label: "Introduction", value: "Concise", note: "Relevant context first" },
  { label: "Base", value: "California", note: "United States" },
  { label: "Routing", value: "Three channels", note: "Clear correspondence categories" },
];
---
<SiteLayout
  active="contact"
  title="Contact | Nolan Investment Office"
  description="Correspondence information and inquiry categories for Nolan Investment Office."
>
  <div class="wrap page-hero contact-page-hero">
    <div class="page-hero-inner" data-reveal>
      <div class="eyebrow">Contact</div>
      <h1>Office correspondence.</h1>
      <div class="page-intro">
        <p>
          The office keeps initial communication straightforward. A concise,
          relevant introduction is preferred to a long presentation at first contact.
        </p>
        <p>
          Nolan Investment Office is based in California, United States.
          Correspondence is reviewed in the context of the office's current
          areas of focus and ongoing work.
        </p>
      </div>
    </div>
  </div>

  <PageSignalDeck items={contactSignals} />

  <section class="page-section contact-page-section">
    <div class="wrap" data-reveal>
      <div class="correspondence-list">
        {channels.map(([n, title, text]) => (
          <article class="correspondence-row" data-module>
            <small class="module-index">{n}</small>
            <h2>{title}</h2>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <RouteModule
    eyebrow="Focus"
    title="Review the office's current areas of attention."
    label="Investment focus"
    href={`${import.meta.env.BASE_URL}focus/`}
  />
</SiteLayout>
