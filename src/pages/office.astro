---
import SiteLayout from "../components/SiteLayout.astro";
import RouteModule from "../components/RouteModule.astro";

const base = import.meta.env.BASE_URL;

const support = [
  ["01", "Investment research", "Sector work, company review, market context and diligence support."],
  ["02", "Operations & coordination", "Day-to-day office administration, scheduling, information flow and project coordination."],
  ["03", "Professional partners", "Legal, accounting and other specialist support engaged when appropriate."],
];

const process = [
  ["01", "Source & context", "A company, sector or opportunity enters the office through direct relationships, referrals or ongoing research."],
  ["02", "Initial review", "The office develops a concise view of the business, people, market and reasons the opportunity may matter."],
  ["03", "Diligence", "When interest remains, the review becomes more detailed and may include operating, commercial and professional input."],
  ["04", "Decision", "Capital is deployed selectively. The office prefers clarity and conviction over maintaining a high volume of activity."],
  ["05", "Ongoing relationship", "After an investment or relationship begins, the office stays direct and practical in its communication and support."],
];
---
<SiteLayout
  active="office"
  title="Office | Nolan Investment Office"
  description="About Nolan Investment Office, its operating structure, leadership and investment review process."
>
  <div class="wrap page-hero">
    <div class="page-hero-inner">
      <div class="eyebrow">The Office · NIO / 02</div>
      <h1>Independent<br />by structure.</h1>
      <div class="page-intro">
        <p>
          Nolan Investment Office is an independent investment office led by
          Renee Nolan, intentionally small and built around direct judgment,
          research and relationships.
        </p>
        <p>
          Specialist professional partners support the office when additional
          legal, accounting or operating expertise is useful.
        </p>
      </div>
    </div>
  </div>

  <section class="v3-leadership" aria-labelledby="leadership-title">
    <figure class="v3-leadership-media">
      <img
        src={`${base}media/office-architecture.webp`}
        alt="Abstract concrete architecture used as an editorial study of structure and light."
        loading="eager"
        decoding="async"
        width="1200"
        height="900"
      />
    </figure>
    <div class="v3-leadership-copy">
      <div class="eyebrow">01 / Leadership</div>
      <h2 id="leadership-title">Clear<br />responsibility.</h2>
      <h3>Renee Nolan</h3>
      <div class="v3-leadership-role">Principal</div>
      <p>
        Renee leads investment decisions and the overall direction of the
        office. Her role centers on judgment, relationships and the final
        allocation of attention and capital.
      </p>
    </div>
  </section>

  <section class="page-section">
    <div class="wrap">
      <div class="section-head">
        <div class="section-number">02 / Operating model</div>
        <h2>Small by intention.</h2>
      </div>
      <div class="v3-operating">
        {support.map(([n, title, text]) => (
          <article>
            <small>{n}</small>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="wrap">
      <div class="section-head">
        <div class="section-number">03 / Process</div>
        <h2>Direct review.<br />Selective decisions.</h2>
      </div>
      <div class="v3-process">
        {process.map(([n, title, text]) => (
          <article>
            <small>{n}</small>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <RouteModule
    eyebrow="Contact"
    title="Start with a concise introduction."
    label="Contact the office"
    href={`${base}contact/`}
  />
</SiteLayout>
