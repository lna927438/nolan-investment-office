---
interface Props {
  className?: string;
  label?: string;
}

const { className = "", label } = Astro.props;
---
<span class={`nio-mark ${className}`} role={label ? "img" : undefined} aria-label={label} aria-hidden={label ? undefined : "true"}>
  <svg viewBox="0 0 40 40" focusable="false">
    <rect class="nio-mark-frame" x="1.5" y="1.5" width="37" height="37" rx="1.5"></rect>
    <path class="nio-mark-letter" d="M10.5 29V11L29.5 29V11"></path>
    <circle class="nio-mark-node" cx="20" cy="20" r="2.15"></circle>
    <path class="nio-mark-axis" d="M20 2.5V7.5M20 32.5V37.5M2.5 20H7.5M32.5 20H37.5"></path>
  </svg>
</span>
