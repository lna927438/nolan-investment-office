---
interface Props {
  className?: string;
  label?: string;
}

const { className = "", label } = Astro.props;
---
<svg
  class:list={["nio-mark", className]}
  viewBox="0 0 64 64"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden={label ? undefined : "true"}
  role={label ? "img" : undefined}
>
  {label && <title>{label}</title>}
  <path class="nio-mark-orbit nio-mark-orbit-primary" d="M8.5 37.5C12.2 49.6 23.6 56 36.4 54.2C47.8 52.6 56.2 44.8 57.3 34.2" />
  <path class="nio-mark-orbit nio-mark-orbit-secondary" d="M18.4 10.8C28.5 6.1 40.8 7.5 49.2 14.3" />
  <path class="nio-mark-letter" d="M16 45.5V18.5L47.5 45.5V18.5" />
  <circle class="nio-mark-node" cx="57.3" cy="34.2" r="2.55" />
</svg>
