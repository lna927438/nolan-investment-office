---
import "../styles/global.css";

interface Props {
  title?: string;
  description: string;
  active?: "home" | "focus" | "office" | "contact" | "legal";
  noindex?: boolean;
  showFooter?: boolean;
}

const {
  title = "Nolan Investment Office",
  description,
  active = "home",
  noindex = true,
  showFooter = true
} = Astro.props;

const base = import.meta.env.BASE_URL;
const url = (path = "") => `${base}${path}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow"} />
    <meta name="theme-color" content="#f1eee7" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url("favicon.svg")} />
    <title>{title}</title>
  </head>
  <body class={active === "home" ? "home-shell" : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap nav">
        <a class="brand" href={url()} aria-label="Nolan Investment Office home">
          <strong>NOLAN</strong>
          <span>Investment Office</span>
        </a>
        <nav aria-label="Primary navigation">
          <a href={url("focus/")} aria-current={active === "focus" ? "page" : undefined}>Focus</a>
          <a href={url("office/")} aria-current={active === "office" ? "page" : undefined}>Office</a>
          <a href={url("contact/")} aria-current={active === "contact" ? "page" : undefined}>Contact</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    {showFooter && (
      <footer>
        <div class="wrap footer-grid">
          <p class="disclaimer">
            For general informational purposes only. Nothing on this website
            constitutes an offer, solicitation, investment recommendation or
            advisory relationship.
          </p>
          <div class="footer-side">
            <span>California, United States</span>
            <a href={url("legal/")} aria-current={active === "legal" ? "page" : undefined}>Legal</a>
            <span>© 2026 Nolan Investment Office</span>
          </div>
        </div>
      </footer>
    )}

    <script is:inline>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const items = document.querySelectorAll('[data-reveal]');
      if (reduceMotion || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12 });
        items.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
