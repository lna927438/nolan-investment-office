---
import NioMark from "./NioMark.astro";
import "../styles/global.css";
import "../styles/reliability.css";
import "../styles/editorial.css";
import "../styles/modules.css";
import "../styles/interior-visuals.css";
import "../styles/signal-deck.css";
import "../styles/page-progress.css";
import "../styles/brand-system.css";
import "../styles/mobile-density.css";
import "../styles/refinement-motion.css";
import "../styles/production-polish.css";
import "../styles/media-layer.css";

interface Props {
  title?: string;
  description: string;
  active?: "home" | "focus" | "office" | "contact" | "legal";
  noindex?: boolean;
  showFooter?: boolean;
}

const {
  title = "Nolan Investment Office",
  description,
  active,
  noindex = true,
  showFooter = true
} = Astro.props;

const base = import.meta.env.BASE_URL;
const url = (path = "") => `${base}${path}`;
const pageName = active ?? "utility";
const pageCodes: Record<string, string> = {
  focus: "NIO / 01",
  office: "NIO / 02",
  contact: "NIO / 03",
  legal: "NIO / L",
};
const pageCode = pageCodes[pageName];
const surfaceStyle = `--nio-surface:url('${url("media/surface-concrete.webp")}')`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow"} />
    <meta name="theme-color" content="#f1eee7" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url("favicon.svg")} />
    <title>{title}</title>
  </head>
  <body class={active === "home" ? "home-shell" : undefined} data-page={pageName} style={surfaceStyle}>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap nav">
        <a class="brand" href={url()} aria-label="Nolan Investment Office home">
          <NioMark className="brand-mark" />
          <span class="brand-copy">
            <strong>NOLAN</strong>
            <span>Investment Office</span>
          </span>
        </a>
        <nav aria-label="Primary navigation">
          <a href={url("focus/")} aria-current={active === "focus" ? "page" : undefined}>Focus</a>
          <a href={url("office/")} aria-current={active === "office" ? "page" : undefined}>Office</a>
          <a href={url("contact/")} aria-current={active === "contact" ? "page" : undefined}>Contact</a>
        </nav>
      </div>
    </header>

    {pageCode && (
      <div class="page-progress-rail" data-page-progress aria-hidden="true">
        <span class="page-progress-section" data-progress-section>Overview</span>
        <div class="page-progress-track">
          <span class="page-progress-fill"></span>
        </div>
        <span class="page-progress-node"></span>
        <span class="page-progress-code">{pageCode}</span>
      </div>
    )}

    <main id="main">
      <slot />
    </main>

    {showFooter && (
      <footer>
        <div class="wrap footer-inner">
          <div class="footer-brand-panel" data-module>
            <div class="footer-brand-lockup">
              <NioMark className="footer-mark" />
              <div class="footer-brand-name">
                <strong>NOLAN</strong>
                <span>Investment Office</span>
              </div>
            </div>
            <div class="footer-brand-meta">
              <span>Independent Investment Office</span>
              <span>California, United States</span>
            </div>
            <nav class="footer-route-map" aria-label="Footer navigation">
              <a href={url("focus/")} aria-current={active === "focus" ? "page" : undefined}>01 / Focus</a>
              <a href={url("office/")} aria-current={active === "office" ? "page" : undefined}>02 / Office</a>
              <a href={url("contact/")} aria-current={active === "contact" ? "page" : undefined}>03 / Contact</a>
            </nav>
          </div>

          <div class="footer-grid">
            <p class="disclaimer">
              For general informational purposes only. Nothing on this website
              constitutes an offer, solicitation, investment recommendation or
              advisory relationship.
            </p>
            <div class="footer-side">
              <span>California, United States</span>
              <a href={url("legal/")} aria-current={active === "legal" ? "page" : undefined}>Legal</a>
              <span>© 2026 Nolan Investment Office</span>
            </div>
          </div>
        </div>
      </footer>
    )}

    <script is:inline>
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

      if (finePointer) {
        let pointerFrame = 0;
        let pointerModule;
        let pointerX = 0;
        let pointerY = 0;

        document.addEventListener('pointermove', (event) => {
          const target = event.target instanceof Element ? event.target.closest('[data-module]') : null;
          if (!target) return;
          pointerModule = target;
          pointerX = event.clientX;
          pointerY = event.clientY;
          if (pointerFrame) return;
          pointerFrame = requestAnimationFrame(() => {
            pointerFrame = 0;
            if (!pointerModule) return;
            const rect = pointerModule.getBoundingClientRect();
            pointerModule.style.setProperty('--module-x', `${pointerX - rect.left}px`);
            pointerModule.style.setProperty('--module-y', `${pointerY - rect.top}px`);
          });
        }, { passive: true });
      }

      const progressRail = document.querySelector('[data-page-progress]');
      if (progressRail) {
        const progressSection = progressRail.querySelector('[data-progress-section]');
        let sectionTimer;
        let progressFrame = 0;
        let activeSection;
        let activeHead;

        const updateProgress = () => {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const progress = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
          progressRail.style.setProperty('--page-progress', progress.toFixed(4));
          document.body.classList.toggle('has-scrolled', window.scrollY > 56);
        };

        const requestProgress = () => {
          if (progressFrame) return;
          progressFrame = requestAnimationFrame(() => {
            progressFrame = 0;
            updateProgress();
          });
        };

        const sectionLabel = (section) => {
          if (section.dataset.sectionLabel) return section.dataset.sectionLabel;
          if (section.classList.contains('page-hero')) return 'Overview';
          if (section.classList.contains('page-signal-deck')) return 'Context';
          if (section.classList.contains('route-section')) return 'Next';
          const numbered = section.querySelector('.section-number');
          if (numbered?.textContent) return numbered.textContent.trim();
          if (section.classList.contains('contact-page-section')) return 'Routing';
          if (section.querySelector('.sector-modules')) return 'Focus areas';
          return 'Section';
        };

        const activateSection = (section) => {
          if (activeSection === section) return;
          activeSection = section;
          const label = sectionLabel(section);
          if (progressSection && progressSection.textContent !== label) {
            progressSection.textContent = label;
            progressRail.classList.remove('is-section-change');
            requestAnimationFrame(() => progressRail.classList.add('is-section-change'));
            clearTimeout(sectionTimer);
            sectionTimer = setTimeout(() => progressRail.classList.remove('is-section-change'), 320);
          }

          if (activeHead) activeHead.classList.remove('nio-section-active');
          activeHead = section.querySelector('.section-head');
          activeHead?.classList.add('nio-section-active');
        };

        const sections = [...document.querySelectorAll('main .page-hero, main .page-signal-deck, main .page-section, main .route-section')];
        if ('IntersectionObserver' in window && sections.length) {
          const observer = new IntersectionObserver((entries) => {
            const visible = entries
              .filter((entry) => entry.isIntersecting)
              .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
            if (visible[0]) activateSection(visible[0].target);
          }, { rootMargin: '-28% 0px -54% 0px', threshold: [0, .01, .08, .2] });
          sections.forEach((section) => observer.observe(section));
          activateSection(sections[0]);
        }

        updateProgress();
        window.addEventListener('scroll', requestProgress, { passive: true });
        window.addEventListener('resize', requestProgress);
        window.addEventListener('pageshow', requestProgress);
      }
    </script>
  </body>
</html>
